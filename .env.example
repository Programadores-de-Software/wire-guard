# Copia este archivo como .env y completa los valores.
# .env esta en .gitignore, nunca se sube al repositorio.

# --- Tunel SSH (make tunnel) ---
SSH_USER=root
SSH_HOST=
SSH_PORT=22
LOCAL_PORT=51821
REMOTE_PORT=51821

# --- Credenciales del panel wg-easy (para make client-create/config/delete) ---
# Deben coincidir con el usuario/password creados en el asistente inicial del panel.
# La API no funciona si el usuario admin tiene 2FA activado.
WG_USER=
WG_PASSWORD=
